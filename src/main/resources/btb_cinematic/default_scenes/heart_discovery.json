// heart_discovery — demonstration scene of the Cinematic Engine.
// Needs the demo set (/btb demo setup) or your own camera preset "heart_flyover" and showcase "heart".
//   1. camera flight over the Nether wasteland, down to the Heart Tower and through its gate  (camera_play heart_flyover)
//   2. the Heart of the Nether appears on its altar                                            (showcase_play heart → REVEAL)
//   3. dramatic showcase animation                    (SHOWCASE: spin, orbiting crystals, later PULSE)
//   4. the HUD shows the name                         (showcase name card "heart_title" + text card)
//   5. particle effects                               (showcase ring/burst, flash, lava burst via command)
//   6. own sounds                                     (heart_reveal, title_hit, nether_drone, nether reverb)
//   7. the camera circles the heart                   (showcase camera orbit)
{
  "id": "heart_discovery",
  "description": "Fly-over of the Heart Tower, reveal and showcase of the Heart of the Nether",
  "duration": 800,
  "on_error": "continue",
  "events": [
    { "time": 0,   "type": "screen_fade", "color": "black", "duration": 1, "hold": -1 },
    { "time": 0,   "type": "letterbox", "intensity": 0.11, "in": 1 },
    { "time": 0,   "type": "reverb", "preset": "nether", "mix": 0.55 },
    { "time": 0,   "type": "music_play", "sound": "btb_cinematic:nether_drone", "volume": 0.8, "fade_in": 60 },
    { "time": 0,   "type": "camera_play", "path": "heart_flyover" },
    { "time": 0,   "type": "vignette", "intensity": 0.75, "in": 40 },
    { "time": 0,   "type": "screen_tint", "color": "nether_red", "intensity": 0.16, "in": 60 },
    { "time": 2,   "type": "effects_clear", "style": "fade", "duration": 40 },

    { "time": 30,  "type": "hud_show", "id": "heart_discovery" },
    { "time": 150, "type": "sound", "sound": "btb_cinematic:rumble", "volume": 1.2 },
    { "time": 170, "type": "camera_shake", "intensity": 0.35, "duration": 30 },

    { "time": 214, "type": "screen_flash", "color": "orange", "duration": 14, "intensity": 0.8 },
    { "time": 214, "type": "showcase_play", "id": "heart" },

    { "time": 275, "type": "sound", "sound": "btb_cinematic:title_hit", "volume": 1.3,
      "echo": { "count": 2, "delay": 14, "decay": 0.4 } },
    { "time": 275, "type": "camera_zoom", "fov": 55, "duration": 80 },

    { "time": 400, "type": "command", "command": "particle minecraft:lava ~ ~ ~ 1 1 1 0.2 40 force" },
    { "time": 500, "type": "showcase_animation", "id": "heart", "animation": "pulse" },
    { "time": 500, "type": "camera_zoom", "fov": 0, "duration": 60 },

    { "time": 620, "type": "music_stop", "fade_out": 100 },
    { "time": 640, "type": "screen_fade", "color": "black", "duration": 60, "hold": -1 },
    { "time": 680, "type": "hud_hide", "out": 20 },
    { "time": 720, "type": "showcase_stop", "id": "heart" },
    // Back from black after the end shot, so nobody is left in the dark (remove for an "end on black" take)
    { "time": 780, "type": "effects_clear", "style": "all", "duration": 30 }
  ]
}
